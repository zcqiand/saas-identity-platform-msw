# VPS nginx vhost — saas-identity-platform-msw
#
# 这份是「参考模板」，不在 nginx include 路径里。.example 后缀让 nginx
# 不会把它当真；部署时由 deploy/saas-identity-platform-msw.sh 每次从 master
# 拉最新渲染成 /etc/nginx/sites-available/$DOMAIN。
#
# 目的:
#   - saas-msw.xiangru.uk 的 HTTP 301 到 HTTPS
#   - HTTPS 终结在 VPS（持 cert）
#   - proxy_pass 到本机容器端口 5100（host=container；ADR-0018 单层 port 方案，
#     由 docker run -p 127.0.0.1:5100:5100 决定；saas 家族 X00 段 = msw 槽位）
#
# 注意:不持有 default_server。同一台 VPS 上若别的 vhost 占了 default_server，
# 重复声明 nginx -t 直接报错。

server {
    listen 80;
    server_name saas-msw.xiangru.uk;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name saas-msw.xiangru.uk;

    # cert / key 在 VPS 本地，**不入仓**
    ssl_certificate     /etc/nginx/ssl/your-cert.cert;
    ssl_certificate_key /etc/nginx/ssl/your-cert.key;

    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;

    # 浏览器一年 HTTPS-only
    add_header Strict-Transport-Security "max-age=31536000" always;

    location / {
        # 容器内 msw HTTP server 监听 :5100（PORT env），host=container=5100
        # 改端口必须同步 deploy/saas-identity-platform-msw.sh 的 -p 与 SERVER_PORT env
        proxy_pass http://127.0.0.1:5100;

        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # ⚠️ 不加 Upgrade / Connection 头:要配 map 块否则 unknown variable
    }
}

# .env.example — saas-msw dev/test env 模板 (committed)
#
# JWT 镜像 saas-identity-platform-{nextjs,springboot,aspnetcore}：
# 三家共享 JWT_SIGNING_KEY，MSW 签出来的 token 在真后端 dev profile
# 也能用 NimbusJwtDecoder / jose verify 验签通过。prod JWT_SIGNING_KEY
# 不在此处（vault / deploy 烘焙），且 MSW 在 prod 不部署（mode=msw 标识）。

JWT_SIGNING_KEY=dev-key-32-bytes-minimum-length!
JWT_ISSUER=saas-identity-platform
JWT_AUDIENCE=saas-identity-platform-clients
JWT_TTL_SECONDS=3600